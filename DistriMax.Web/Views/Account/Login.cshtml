@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ingreso - DistriMax</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.4.1/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body class="login">
    <div class="login-caja">
        <h1 class="login-marca">Distri<strong>Max</strong></h1>
        <p class="login-sub">Sistema de gestión comercial</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" action="@Url.Action("Login", "Account")">
            <div class="form-group">
                <label for="usuario">Usuario</label>
                <input type="text" class="form-control" id="usuario" name="usuario" value="@ViewBag.Usuario" autocomplete="username" autofocus />
            </div>
            <div class="form-group">
                <label for="password">Contraseña</label>
                <input type="password" class="form-control" id="password" name="password" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-dm btn-block">Ingresar</button>
        </form>

        <p class="login-ayuda">Ambiente de pruebas: admin / admin123</p>
    </div>
</body>
</html>
